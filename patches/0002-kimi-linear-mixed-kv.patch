diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index ef53728..b11e507 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -3724,7 +3724,13 @@ llama_context * llama_init_from_model(
         }
     }
 
-    if ((model->hparams.is_mla() || model->arch == LLM_ARCH_DEEPSEEK4) && params.type_k != params.type_v) {
+    if ((model->hparams.is_mla() || model->arch == LLM_ARCH_DEEPSEEK4) && params.type_k != params.type_v
+            && model->arch != LLM_ARCH_KIMI_LINEAR) {
+        // fastollama: allow different K/V cache types for kimi-linear. For deepseek
+        // MLA the V cache duplicates K-cache data, so mixed types are correctness-
+        // critical there; kimi-linear's K (576-dim latent+rope) and V caches hold
+        // different tensors, and its KDA layers force V to f16 anyway (V-state
+        // head_dim 72 is not divisible by the 32-wide quant block).
         LLAMA_LOG_ERROR("%s: model does not support different K (%s) and V (%s) cache types\n", __func__, ggml_type_name(params.type_k), ggml_type_name(params.type_v));
         return nullptr;
     }
